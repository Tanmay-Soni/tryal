# Local Convoke integration settings.
# Copy this to .env, fill in real values, then source it before running Uvicorn.

CONVOKE_MOCK=true
CONVOKE_MCP_URL=
CONVOKE_MCP_TRANSPORT=streamable-http

# Use whichever auth shape Convoke provides.
CONVOKE_MCP_AUTH_TOKEN=
CONVOKE_MCP_AUTH_HEADER=Authorization
CONVOKE_MCP_API_KEY=
CONVOKE_MCP_API_KEY_HEADER=X-API-Key

# Optional escape hatch for additional headers, as a JSON object.
# Example: {"X-Tenant-Id":"your-tenant"}
CONVOKE_MCP_HEADERS_JSON=
